# wasm build artefacts (rebuilt from source via web/build.sh)
web/protozoa.wasm
web/wasm_exec.js
compiled
.gitignore
*.idea
*.iml
.claude
Claude.md
protozoa
testdata/*.pzr

# Recordings saved from the viewer's Save Recording As. Binary, and
# capped at max_replay_size_mb (250MB by default) apiece.
recordings/

# Editor config.
.vscode/

# Output of the animation previewer's GIF export, regenerated on demand.
gif_exports/

# Superseded Aseprite sources. resources/sprites.aseprite is the one the
# export script reads; these are earlier versions kept on disk only.
resources/sprites_with_*.aseprite

# Release artifacts staged by dist.sh and uploaded by push.sh.
dist/

# The release runbook: the itch.io target, butler setup and the deploy steps.
# Local only - it is about this account and this machine rather than about the
# project, and resources/README.md already carries the sprite pipeline, which
# IS part of the project.
DEPLOY.md
